# --- PC #4 Enterprise IT ---
CONTROL_ROOM_HOST=10.10.0.20    # PC #3 citadel-hmi (MQTT broker, reached via PC #4 NIC 2)
POSTGRES_USER=citadel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=citadel
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
